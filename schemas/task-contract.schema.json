{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CEAL Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "transaction_id",
    "task_type",
    "objective",
    "acceptance",
    "risk_level",
    "scope",
    "authorization",
    "dependency_change",
    "external_side_effects",
    "side_effect_permissions",
    "max_repair_loops",
    "stop_conditions",
    "rollback",
    "evidence_plan",
    "capability_lease",
    "frozen_identity"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "transaction_id": {"type": "string", "minLength": 1},
    "task_type": {
      "enum": ["FEATURE", "BUGFIX", "REFACTOR", "DOCS", "DEPENDENCY", "MIGRATION", "RELEASE", "GOVERNANCE_CHANGE"]
    },
    "objective": {"type": "string", "minLength": 1},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "risk_level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths", "denied_paths"],
      "properties": {
        "allowed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "denied_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized_changes", "forbidden_changes"],
      "properties": {
        "authorized_changes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "forbidden_changes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "dependency_change": {"type": "boolean"},
    "external_side_effects": {"type": "boolean"},
    "side_effect_permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "max_repair_loops": {"type": "integer", "minimum": 0},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "source_preservation_required"],
      "properties": {
        "strategy": {"type": "string", "minLength": 1},
        "source_preservation_required": {"type": "boolean"}
      }
    },
    "evidence_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_levels", "required_artifacts"],
      "properties": {
        "required_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5"]}
        },
        "required_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "capability_lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities", "expires_on_task_end"],
      "properties": {
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "expires_on_task_end": {"const": true},
        "max_uses": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "frozen_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_sha256", "baseline_id"],
      "properties": {
        "policy_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "baseline_id": {"type": "string", "minLength": 1},
        "source_tree_identity": {"type": ["string", "null"], "minLength": 1}
      },
      "description": "Externally frozen identity. The task-contract hash itself is computed by the transaction envelope over canonical contract bytes; it is intentionally not self-embedded here."
    }
  }
}
