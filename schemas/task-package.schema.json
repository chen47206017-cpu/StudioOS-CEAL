{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chen47206017-cpu/StudioOS-CEAL/schemas/task-package.schema.json",
  "title": "CEAL Task Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "title",
    "mode",
    "status",
    "risk_level",
    "scope",
    "acceptance",
    "rollback",
    "stop_conditions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "answer",
        "diagnose",
        "implement_and_verify",
        "read_only_audit"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "APPROVED_FOR_PREPARATION",
        "APPROVED_FOR_IMPLEMENTATION",
        "IMPLEMENTING",
        "BLOCKED",
        "CODE_COMPLETE",
        "TEST_PASS",
        "RUNTIME_VERIFIED",
        "CLOSED"
      ]
    },
    "risk_level": {
      "enum": ["L0", "L1", "L2", "L3"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow", "deny"],
      "properties": {
        "allow": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_commands",
        "runtime_evidence_required",
        "production_evidence_required"
      ],
      "properties": {
        "required_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtime_evidence_required": {
          "type": "boolean"
        },
        "production_evidence_required": {
          "type": "boolean"
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
