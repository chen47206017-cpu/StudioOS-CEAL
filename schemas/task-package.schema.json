{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"CEAL Task Execution Package",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","task_id","transaction_id","task_contract_sha256","policy_sha256","baseline_id","title","mode","status","risk_level","scope","changed_paths","changeset_source","changeset_complete","acceptance","rollback","stop_conditions","capabilities","side_effect_permissions","external_side_effects"],
  "properties":{
    "schema_version":{"const":"1.1"},
    "task_id":{"type":"string","minLength":1},"transaction_id":{"type":"string","minLength":1},
    "task_contract_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},"policy_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "baseline_id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},
    "mode":{"enum":["answer","diagnose","implement_and_verify","read_only_audit"]},
    "status":{"enum":["DRAFT","APPROVED_FOR_PREPARATION","APPROVED_FOR_IMPLEMENTATION","IMPLEMENTING","BLOCKED","CODE_COMPLETE","TEST_PASS","RUNTIME_VERIFIED","AUDIT_PENDING","AUDIT_APPROVED","REPAIR_REQUIRED","RELEASE_APPROVED","CLOSED"]},
    "risk_level":{"enum":["L0","L1","L2","L3","L4"]},
    "scope":{"type":"object","additionalProperties":false,"required":["allow","deny"],"properties":{"allow":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"deny":{"type":"array","items":{"type":"string","minLength":1}}}},
    "changed_paths":{"type":"array","items":{"type":"string","minLength":1}},
    "changeset_source":{"enum":["DECLARED","DISCOVERED_GIT"]},"changeset_complete":{"type":"boolean"},
    "acceptance":{"type":"object","additionalProperties":false,"required":["required_commands","runtime_evidence_required","production_evidence_required"],"properties":{"required_commands":{"type":"array","items":{"type":"string","minLength":1}},"runtime_evidence_required":{"type":"boolean"},"production_evidence_required":{"type":"boolean"}}},
    "rollback":{"type":"object","additionalProperties":false,"required":["strategy"],"properties":{"strategy":{"type":"string","minLength":1}}},
    "stop_conditions":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "capabilities":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "side_effect_permissions":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "external_side_effects":{"type":"boolean"}
  },
  "allOf":[{"if":{"properties":{"status":{"enum":["CODE_COMPLETE","TEST_PASS","RUNTIME_VERIFIED","AUDIT_PENDING","AUDIT_APPROVED","RELEASE_APPROVED","CLOSED"]}},"required":["status"]},"then":{"properties":{"changeset_complete":{"const":true},"changeset_source":{"const":"DISCOVERED_GIT"}}}}]
}
